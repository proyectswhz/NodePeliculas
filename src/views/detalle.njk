{% extends "index.njk" %}
{% block title %}
    {{ movie.title }} - Node Películas{% endblock %}
{% block content %}
    <div class="detalle-container">
        <div class="detalle-card">
            <div class="detalle-poster">
                <img src="{{ movie.poster }}" alt="{{ movie.title }}" onerror="this.src='https://via.placeholder.com/300x450?text=Sin+Imagen'"></div>
                <div class="detalle-info">
                    <h2 class="detalle-titulo">{{ movie.title }}</h2>
                    <p class="detalle-dato">
                        <strong>Año:</strong>
                        {{ movie.year }}</p>
                    <p class="detalle-dato">
                        <strong>Duración:</strong>
                        {{ movie.duration }} min</p>
                    <p class="detalle-dato">
                        <strong>Director:</strong>
                        {{ movie.director }}</p>
                    <p class="detalle-dato">
                        <strong>Género:</strong>
                        {{ movie.genre | join(", ") }}</p>
                    <p class="detalle-dato">
                        <strong>Valoración:</strong>
                        {{ movie.rate }} / 10</p>
                    <div class="detalle-acciones">
                        <form action="/movies/{{ movie._id }}/favorite" method="POST">
                            <button type="submit" class="btn-fav {% if movie.favorite %}is-favorite{% endif %}">
                                {% if movie.favorite %}♥ Favorita{% else %}♡ Favorita{% endif %}
                            </button>
                        </form>
                        <a href="/movies/editar/{{ movie._id }}" class="btn-editar">Editar película</a>
                        <form action="/movies/eliminar/{{ movie._id }}" method="POST">
                            <button type="submit" class="btn-delete" onclick="return confirm('¿Estás seguro de que quieres borrar esta película?')">
                                Eliminar
                            </button>
                        </form>
                        <a href="/movies" class="btn-volver">Volver al inicio</a>
                    </div>
                </div>
            </div>
        </div>
    {% endblock %}